# Groq API key for the LLM (https://console.groq.com/keys). Required to answer
# questions; the API still starts without it and /query returns a clear 503.
GROQ_API_KEY=

# Groq model to use for answering questions
GROQ_MODEL=llama-3.3-70b-versatile

# Smaller model for memory housekeeping: rewriting follow-ups, summaries, learning preferences
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Optional: if set, OpenAI embeddings are used instead of the local
# HuggingFace fallback (sentence-transformers/all-MiniLM-L6-v2)
OPENAI_API_KEY=

# Embedding model used when OPENAI_API_KEY is set
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Embedding model used when OPENAI_API_KEY is NOT set (local, no key needed)
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Text splitting
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval
RETRIEVER_TOP_K=6

# Where persisted FAISS indexes are stored
INDEX_STORE_DIR=data/indexes

# Max file size (bytes) to ingest; larger files are skipped
MAX_FILE_SIZE_BYTES=1000000

# Memory: chats, summaries and user memories are stored in this SQLite file
MEMORY_DB_PATH=data/memory.db
# Older turns are folded into a running summary once a chat has more than this many messages
SUMMARIZE_AFTER_MESSAGES=10
# Learn user preferences ("I'm new to Python", "keep it short") from what they say
AUTO_MEMORY=true

# Comma-separated browser origins allowed to call the API (the frontend dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
